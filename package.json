{
  "name": "resilient-backend-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade, resilient Node.js and TypeScript backend boilerplate with PostgreSQL, Redis, rate-limiting, and graceful shutdown.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Linting passed\""
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "postgresql",
    "redis",
    "resilience",
    "production-ready"
  ],
  "author": "Mukasa Matthew",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
